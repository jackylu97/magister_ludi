new file mode 100644
index 00000000..c59a6173
--- /dev/null
+++ b/test/sim/citizenSixYields.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from 'vitest';
+import { valueContext } from '../../src/ai/bot';
+import { citizenWouldWork, type PlanEntry } from '../../src/ai/plan';
+import { assignableTiles, assignCitizens, foodUpkeep, foundCityAt, yieldScore } from '../../src/sim/cities';
+import { type ImprovementId } from '../../src/sim/improvementData';
+import { createMap, getTileAt, raiseImprovement, tileIndex } from '../../src/sim/map';
+import { type CitizenFocus, RULES } from '../../src/sim/rulesData';
+import { bumpRevision } from '../../src/sim/state';
+import { resetVisibility } from '../../src/sim/visibility';
+import { cityContext, foldTile } from '../../src/sim/yields/hex';
+import { foldCity } from '../../src/sim/yields/town';
+import { newGame } from './newGameHelpers';
+
+function town(focus: CitizenFocus = 'default') {
+  const state = newGame({seed: 104, sizeName: 'duel', players: [{name: 'West', color: '#900'}, {name: 'East', color: '#049'}]});
+  state.map = createMap({ width: 14, height: 12, terrain: 'grassland' });
+  state.tileOwner = new Array<number | null>(state.map.tiles.length).fill(null);
+  state.units = [];
+  resetVisibility(state);
+  const city = foundCityAt(state, 0, getTileAt(state.map, 6, 5)!);
+  if (focus !== 'default') city.focus = focus;
+  const tiles = assignableTiles(state, city).sort((a, b) => tileIndex(state.map, a.col, a.row) - tileIndex(state.map, b.col, b.row));
+  const first = tiles[0]!;
+  const last = tiles[tiles.length - 1]!;
+  assignCitizens(state, city);
+  expect(city.workedTiles).toEqual([{col: first.col, row: first.row}]);
+  return {state, city, first, last};
+}
+
+const cases: [ImprovementId, 'science' | 'culture' | 'faith', number][] = [
+  ['academy','science',4], ['landmark','culture',4], ['stoneCircle','faith',2],
+];
+
+describe('automatic assignment across the six tile yields', () => {
+  for (const focus of ['default','food','production','gold'] as const) {
+    it.each(cases)(`works a %s on equal ground under ${focus} focus`, (work, voice, income) => {
+      const {state, city, first, last} = town(focus);
+      const ground = cityContext(state, city);
+      const improved = foldTile({...last, improvement: work}, ground);
+      const bare = foldTile(first, ground);
+      const entry: PlanEntry = {
+        col:last.col, row:last.row, improvement:work, improved, town:city.id, label:work, value:0, terms:[],
+        seatless:0, seatlessTerms:[], unclaimed:true,
+      };
+      expect(citizenWouldWork(state, valueContext(state,state.players[0]!), entry).works).toBe(true);
+      raiseImprovement(last,work,state.turn);
+      bumpRevision(state);
+      assignCitizens(state,city);
+      expect(city.workedTiles).toEqual([{col:last.col,row:last.row}]);
+      expect(improved[voice]-bare[voice]).toBe(income);
+      expect(yieldScore(improved, RULES.cities.expansion.yieldWeights)).toBe(yieldScore(bare, RULES.cities.expansion.yieldWeights));
+    });
+  }
+  it('works one upgraded Academy when working both would starve the town', () => {
+    const {state, city} = town();
+    city.population=3;
+    state.players[0]!.techsResearched.push('philosophy','education');
+    for(const tile of assignableTiles(state,city).slice(-2)) {
+      tile.terrain='desert';
+      raiseImprovement(tile,'academy',state.turn);
+    }
+    bumpRevision(state);
+    assignCitizens(state,city);
+    const rates=foldCity(state,city);
+    expect(rates.food).toBe(foodUpkeep(city));
+    expect(rates.science).toBe(9.75);
+  });
+
+  it('honours a manual lock even with a four-science Academy on equal ground', () => {
+    const {state,city,first,last} = town();
+    raiseImprovement(last,'academy',state.turn);
+    city.lockedTiles = [{col:first.col,row:first.row}];
+    bumpRevision(state);
+    assignCitizens(state,city);
+    expect(city.workedTiles).toEqual(city.lockedTiles);
+  });
+});

+++ b/scripts/checkCitizenFood.ts
@@ -0,0 +1,41 @@
+import { assignableTiles, assignCitizens, foodUpkeep, foundCityAt, yieldScore } from '../src/sim/cities';
+import { createGame } from '../src/sim/game';
+import { createMap, getTileAt, raiseImprovement } from '../src/sim/map';
+import { RULES } from '../src/sim/rulesData';
+import { bumpRevision } from '../src/sim/state';
+import { resetVisibility } from '../src/sim/visibility';
+import { cityContext, foldTile } from '../src/sim/yields/hex';
+import { foldCity } from '../src/sim/yields/town';
+
+for (const weight of [0,1,2]) {
+  const sheets = [RULES.cities.citizenWeights,...Object.values(RULES.cities.citizenFocusWeights)];
+  for(const sheet of sheets) sheet.science=sheet.culture=sheet.faith=weight;
+  const {state}=createGame({seed:104,sizeName:'duel',players:[{name:'West',color:'#900'},{name:'East',color:'#049'}]});
+  state.map=createMap({width:14,height:12,terrain:'grassland'});
+  state.tileOwner=new Array(state.map.tiles.length).fill(null);
+  state.units=[]; resetVisibility(state);
+  const city=foundCityAt(state,0,getTileAt(state.map,6,5)!);
+  city.population=3;
+  state.players[0]!.techsResearched.push('philosophy','education');
+  for (const tile of assignableTiles(state,city).slice(-2)) {
+    tile.terrain='desert'; raiseImprovement(tile,'academy',state.turn);
+  }
+  bumpRevision(state); assignCitizens(state,city);
+  const {food,science}=foldCity(state,city);
+  const greedy = [...city.workedTiles];
+  // Six available hexes and three citizens give twenty possible assignments.
+  // Use the rules' actual food total to find the highest-scoring affordable set.
+  const tiles = assignableTiles(state,city);
+  const ground = cityContext(state,city);
+  let best: { score:number; food:number; science:number } | undefined;
+  for (let a=0; a<tiles.length-2; a++) for(let b=a+1; b<tiles.length-1; b++) for(let c=b+1; c<tiles.length; c++) {
+    const chosen = [tiles[a]!,tiles[b]!,tiles[c]!];
+    city.workedTiles=chosen.map(({col,row})=>({col,row}));
+    bumpRevision(state);
+    const rates=foldCity(state,city);
+    if(rates.food<foodUpkeep(city)) continue;
+    const score=chosen.reduce((sum,tile)=>sum+yieldScore(foldTile(tile,ground)),0);
+    if(!best || score>best.score) best={score,food:rates.food,science:rates.science};
+  }
+  console.log(JSON.stringify({weight,food,upkeep:foodUpkeep(city),science,worked:greedy,bestFed:best}));
+}
diff --git a/scripts/checkCitizenPlay.ts b/scripts/checkCitizenPlay.ts
new file mode 100644
index 00000000..2c8b3c47
--- /dev/null
+++ b/scripts/checkCitizenPlay.ts
@@ -0,0 +1,37 @@
+// Two matched games per seed. Both seats use the same citizen rules in a game.
+import { driveBots } from '../src/ai/driver';
+import { createGame } from '../src/sim/game';
+import { type LeaderId } from '../src/sim/leaderData';
+import { readEmpireRates } from '../src/sim/readings';
+import { RULES } from '../src/sim/rulesData';
+import { explainScore, foldScore } from '../src/sim/score';
+import { realPlayers } from '../src/sim/state';
+import { TILE_YIELD_KEYS } from '../src/sim/terrainData';
+
+const seed = Number(process.argv[2]);
+const turns = Number(process.argv[3] ?? 100);
+const leaders: LeaderId[] = seed % 2 ? ['harunAlRashid', 'sejongTheGreat'] : ['justinian', 'cleopatra'];
+for (const weight of [0, 1]) {
+  for (const sheet of [RULES.cities.citizenWeights, ...Object.values(RULES.cities.citizenFocusWeights)]) {
+    sheet.science = weight;
+    sheet.culture = weight;
+    sheet.faith = weight;
+  }
+  const game = createGame({
+    seed, sizeName: 'duel', barbarians: true,
+    players: leaders.map((leader, index) => ({name: leader, color: ['#900', '#049'][index]!, leader})),
+  });
+  let warnings = 0;
+  while (game.state.turn <= turns && game.state.winnerId === null) {
+    const before = game.state.turn;
+    driveBots(game, {warn: () => { warnings += 1; }});
+    if (game.state.turn === before) throw new Error('Stalled at turn ' + before);
+  }
+  const seats = realPlayers(game.state).map(player => {
+    const rates = readEmpireRates(game.state, player.id);
+    const score = foldScore(explainScore(game.state, player.id));
+    const yields = Object.fromEntries(TILE_YIELD_KEYS.map(key => [key, rates[`${key}PerTurn`] ?? 0]));
+    return {leader: player.leader, score, techs: player.techsResearched.length, drafts: player.statecraft.drafts, yields};
+  });
+  console.log(JSON.stringify({seed, weight, turns: game.state.turn - 1, warnings, seats}));
+}
diff --git a/scripts/checkCitizenWeights.ts b/scripts/checkCitizenWeights.ts
new file mode 100644
index 00000000..78f9eec4
--- /dev/null
+++ b/scripts/checkCitizenWeights.ts
@@ -0,0 +1,54 @@
+// Local experiment on copies of played positions. Only the original weights advance the real game.
+import { createGame, restoreState, snapshotState } from '../src/sim/game';
+import { driveBots } from '../src/ai/driver';
+import { assignCitizens, foodUpkeep } from '../src/sim/cities';
+import { foldCity } from '../src/sim/yields/town';
+import { RULES } from '../src/sim/rulesData';
+import { type GameState } from '../src/sim/state';
+import { type LeaderId } from '../src/sim/leaderData';
+import { TILE_YIELD_KEYS, emptyTileYield } from '../src/sim/terrainData';
+
+const seed = Number(process.argv[2]);
+const end = Number(process.argv[3] ?? 90);
+const leaders: LeaderId[] = seed%2 ? ['harunAlRashid','sejongTheGreat'] : ['justinian','cleopatra'];
+const allSheets = [RULES.cities.citizenWeights, ...Object.values(RULES.cities.citizenFocusWeights)];
+function weights(value: number): void {
+  for (const sheet of allSheets) sheet.culture=sheet.science=sheet.faith=value;
+}
+function position(state: GameState, w: number) {
+  weights(w);
+  const copy = restoreState(snapshotState(state));
+  return copy.cities.map(city => {
+    assignCitizens(copy,city);
+    return {id:city.id,worked:JSON.stringify(city.workedTiles),required:foodUpkeep(city),yields:foldCity(copy,city)};
+  });
+}
+weights(0);
+const game=createGame({seed,sizeName:'duel',barbarians:true,players:leaders.map((leader,i)=>({leader,name:leader,color:['#900','#049'][i]!}))});
+const results=[1,2].map(weight=>({weight,samples:0,swaps:0,newDeficits:0,delta:emptyTileYield()}));
+let warnings=0;
+const examples: unknown[]=[];
+while (game.state.turn<=end && game.state.winnerId===null) {
+  const turn=game.state.turn;
+  driveBots(game,{warn:()=>warnings++});
+  if(game.state.turn===turn) throw Error('Stalled at turn '+turn);
+  if(turn%10!==0) continue;
+  const baseline=position(game.state,0);
+  for(const result of results){
+    for (const [idx,row] of position(game.state,result.weight).entries()) {
+      const old=baseline[idx]!;
+      result.samples++;
+      if(row.worked===old.worked) continue;
+      result.swaps++;
+      if (old.yields.food >= old.required && row.yields.food < row.required) result.newDeficits++;
+      const difference=emptyTileYield();
+      for(const key of TILE_YIELD_KEYS) {
+        difference[key]=row.yields[key]-old.yields[key];
+        result.delta[key]+=difference[key];
+      }
+      if(result.weight===1 && examples.length<5) examples.push({turn,city:row.id,difference});
+    }
+  }
+  weights(0);
+}
+console.log(JSON.stringify({seed,turns:game.state.turn-1,leaders,warnings,results,examples}));

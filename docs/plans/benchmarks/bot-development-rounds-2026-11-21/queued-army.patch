   const wanted = standing + ctx.threat * ai.threat.extraArmyPerThreat + sighted.extra;
   const held = fieldSoldiersOf(ctx.state, ctx.playerId).length;
+  // Front rows are committed production. A replacement comparison must not
+  // count the row it could replace. Scouts and later queue rows are not supply.
+  let queued = 0;
+  for (const city of ctx.state.cities) {
+    if (city.ownerId !== ctx.playerId || city.id === replacingCityId) continue;

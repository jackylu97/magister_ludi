diff --git a/test/sim/aiResearchProgress.test.ts b/test/sim/aiResearchProgress.test.ts
new file mode 100644
--- /dev/null
+++ b/test/sim/aiResearchProgress.test.ts
@@ -0,0 +1,71 @@
+import { describe, expect, it } from 'vitest';
+import { valueContext } from '../../src/ai/bot';
+import { researchRoad, techChain } from '../../src/ai/chain';
+import { bumpRevision } from '../../src/sim/state';
+import { techDef } from '../../src/sim/techData';
+import { newGame } from './newGameHelpers';
+
+function fixture() {
+  const state = newGame({ seed: 29, sizeName: 'duel', players: [{ name: 'A', color: '#a00' }, { name: 'B', color: '#00a' }] });
+  const player = state.players[0]!;
+  const context = () => ({ ...valueContext(state, player), scienceRate: 10 });
+  return { state, player, context };
+}
+
+describe('research progress in bot completion estimates', () => {
+  it('credits active and parked progress only on the technologies the plan includes', () => {
+    const { state, player, context } = fixture();
+    const before = researchRoad(state, player, context(), 'letters');
+    const [first, second] = before.road;
+    expect(before.road.length).toBeGreaterThan(1);
+    player.researching = first!;
+    player.sciencePool = before.costs[0]! - 3;
+    player.techProgress = { [second!]: before.costs[1]! - 4 };
+    bumpRevision(state);
+    const snapshot = JSON.stringify(state);
+    const after = researchRoad(state, player, context(), 'letters');
+    expect(after.costs.slice(0, 2)).toEqual([3, 4]);
+    expect(after.beakers).toBe(7 + before.costs.slice(2).reduce((sum, cost) => sum + cost, 0));
+    expect(after.delay).toBe(after.beakers / 10);
+    expect(JSON.stringify(state)).toBe(snapshot);
+  });
+
+  it('does not spend the active bank on an unrelated research path', () => {
+    const { state, player, context } = fixture();
+    const before = researchRoad(state, player, context(), 'fletching');
+    expect(before.road).not.toContain('sailing');
+    player.researching = 'sailing';
+    player.sciencePool = 1000;
+    bumpRevision(state);
+    const after = researchRoad(state, player, context(), 'fletching');
+    expect(after.beakers).toBe(before.beakers);
+  });
+
+  it('uses unassigned science once and carries excess to the next node', () => {
+    const { state, player, context } = fixture();
+    const before = researchRoad(state, player, context(), 'letters');
+    player.researching = null;
+    player.sciencePool = before.costs[0]! + 5;
+    bumpRevision(state);
+    const after = researchRoad(state, player, context(), 'letters');
+    expect(after.costs[0]).toBe(0);
+    expect(after.costs[1]).toBe(before.costs[1]! - 5);
+    expect(after.beakers).toBe(before.beakers - player.sciencePool);
+  });
+
+  it('uses remaining research for the unlock delay as well as the whole path', () => {
+    const { state, player, context } = fixture();
+    const before = researchRoad(state, player, context(), 'fletching');
+    player.researching = before.road[0]!;
+    player.sciencePool = before.costs[0]! - 2;
+    bumpRevision(state);
+    const ctx = context();
+    const road = researchRoad(state, player, ctx, 'fletching');
+    const chain = techChain(state, player, ctx, 'fletching');
+    const id = techDef('fletching').unlocks.units![0]!;
+    const step = chain.steps.find(row => row.kind === 'unit' && row.id === id)!;
+    expect(chain.remainingBeakers).toBe(road.beakers);
+    expect(step.delay).toBe(road.delay);
+    expect(step.delay).toBeLessThan(before.delay);
+  });
+});

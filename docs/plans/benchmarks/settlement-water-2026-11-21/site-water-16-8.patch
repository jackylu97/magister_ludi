diff --git a/test/sim/siteWater.test.ts b/test/sim/siteWater.test.ts
new file mode 100644
index 00000000..992dbc80
--- /dev/null
+++ b/test/sim/siteWater.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, it } from 'vitest';
+import { withAiTuning } from '../../src/ai/aiConfig';
+import { explainSiteValue, valueContext } from '../../src/ai/bot';
+import { claimTile, foundCityAt, isCoastalCity } from '../../src/sim/cities';
+import { createMap, getTileAt, raiseImprovement, tileIndex } from '../../src/sim/map';
+import { RULES } from '../../src/sim/rulesData';
+import { explainSite, rankSites } from '../../src/sim/sites';
+import { bumpRevision } from '../../src/sim/state';
+import { EXPLORED, HIDDEN, resetVisibility } from '../../src/sim/visibility';
+import { game } from './statecraftHelpers';
+
+function board() {
+  const { state } = game();
+  state.map = createMap({ width: 24, height: 16, terrain: 'grassland' });
+  for (const tile of state.map.tiles) {
+    tile.resource = 'wheat';
+    raiseImprovement(tile, 'farm', state.turn);
+  }
+  state.tileOwner = Array(state.map.tiles.length).fill(null);
+  state.camps = [];
+  resetVisibility(state);
+  state.visibility[0]!.fill(EXPLORED);
+  const site = getTileAt(state.map, 10, 7)!;
+  for (const unit of state.units) {
+    unit.col = unit.ownerId === 0 ? site.col : 19;
+    unit.row = site.row;
+  }
+  bumpRevision(state);
+  const water = (seat = 0) => explainSiteValue(state, new Set(), valueContext(state, state.players[seat]!), site).terms
+    .filter(line => ['fresh water', 'on the coast', 'coast within reach'].includes(line.label));
+  return { state, site, water };
+}
+
+describe('water in a settlement suggestion', () => {
+  it('puts a fresh-water site first on equal ground and gives a bot the same value', () => {
+    const { state, site, water } = board();
+    site.freshwater = true;
+    bumpRevision(state);
+    const lens = rankSites(state, 0)[0]!;
+    expect([lens.col, lens.row]).toEqual([site.col, site.row]);
+    const line = { label: 'fresh water', value: RULES.sites.freshWater };
+    expect(lens.reading.lines).toContainEqual(line);
+    expect(water()).toEqual([line]);
+  });
+
+  it.each([1, 2])('prices coast %i hexes from the site and checks when the town can use it', distance => {
+    const { state, site, water } = board();
+    const sea = getTileAt(state.map, site.col + distance, site.row)!;
+    sea.terrain = 'coast';
+    bumpRevision(state);
+    const label = distance === 1 ? 'on the coast' : 'coast within reach';
+    const line = { label, value: RULES.sites.coast };
+    expect(explainSite(state, 0, site).lines).toContainEqual(line);
+    expect(water()).toEqual([line]);
+    const city = foundCityAt(state, 0, site);
+    expect(isCoastalCity(state, city)).toBe(distance === 1);
+    if (distance === 2) {
+      expect(claimTile(state, city, sea)).toBe(true);
+      expect(isCoastalCity(state, city)).toBe(true);
+    }
+  });
+
+  it('changes both water weights for one seat and keeps the lens and other seat on the shared weights', () => {
+    const { state, site, water } = board();
+    site.freshwater = true;
+    getTileAt(state.map, site.col + 1, site.row)!.terrain = 'coast';
+    state.visibility[1]!.fill(EXPLORED);
+    bumpRevision(state);
+    const defaults = [
+      { label: 'fresh water', value: RULES.sites.freshWater },
+      { label: 'on the coast', value: RULES.sites.coast },
+    ];
+    withAiTuning({ site: { freshWaterBonus: 3, coastalAccessBonus: 0 } }, () => {
+      expect(water(0)).toEqual([{ label: 'fresh water', value: 3 }, { label: 'on the coast', value: 0 }]);
+      expect(water(1)).toEqual(defaults);
+      expect(explainSite(state, 0, site).lines).toEqual(expect.arrayContaining(defaults));
+    }, { playerId: 0 });
+    expect(water(0)).toEqual(defaults);
+  });
+
+  it('counts a known water source and coast together', () => {
+    const { state, site, water } = board();
+    const source = getTileAt(state.map, site.col - 1, site.row)!;
+    const sea = getTileAt(state.map, site.col + 1, site.row)!;
+    sea.terrain = 'coast';
+    raiseImprovement(source, 'qanat', state.turn);
+    const at = tileIndex(state.map, source.col, source.row);
+    state.visibility[0]![at] = HIDDEN;
+    bumpRevision(state);
+    expect(water().map(line => line.label)).toEqual(['on the coast']);
+    state.visibility[0]![at] = EXPLORED;
+    bumpRevision(state);
+    expect(water().map(line => line.label)).toEqual(['fresh water', 'on the coast']);
+  });
+
+  it('uses the coast that a new town inherits from an outpost', () => {
+    const { state, site, water } = board();
+    const home = foundCityAt(state, 0, getTileAt(state.map, 3, 7)!);
+    const sea = getTileAt(state.map, site.col + 1, site.row)!;
+    sea.terrain = 'coast';
+    claimTile(state, home, site);
+    claimTile(state, home, sea);
+    raiseImprovement(site, 'outpost', state.turn);
+    bumpRevision(state);
+    expect(water()).toEqual([{ label: 'on the coast', value: RULES.sites.coast }]);
+    expect(isCoastalCity(state, foundCityAt(state, 0, site))).toBe(true);
+  });
+
+  it('excludes hidden water, water held by another town and lakes', () => {
+    const { state, site, water } = board();
+    const sea = getTileAt(state.map, site.col + 2, site.row)!;
+    const at = tileIndex(state.map, sea.col, sea.row);
+    sea.terrain = 'coast';
+    state.visibility[0]![at] = HIDDEN;
+    expect(water()).toEqual([]);
+    state.visibility[0]![at] = EXPLORED;
+    state.tileOwner[at] = 100;
+    bumpRevision(state);
+    expect(explainSite(state, 0, site).coast).toBe(false);
+    expect(water()).toEqual([]);
+    state.tileOwner[at] = null;
+    sea.terrain = 'lake';
+    bumpRevision(state);
+    expect(water()).toEqual([]);
+  });
+});
